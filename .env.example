# ==============================================================================
# HOSPITIQ — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection URI (Keep private, never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospitiq?retryWrites=true&w=majority

# JWT / Cryptographic HMAC Session Secret (Generate a strong 64-char random hex)
JWT_SECRET=your_secure_random_64_character_hmac_secret_key_here

# Hospital Instance Name
HOSPITAL_NAME=HOSPITIQ Central Hospital
